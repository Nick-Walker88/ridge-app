# Postgres
DATABASE_URL="postgresql://postgres:ridge_dev@localhost:5432/ridge"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Garmin Connect Developer Program (https://developer.garmin.com/gc-developer-program/)
# Leave unset to run against the built-in mock provider (realistic sample
# history, no real Garmin account needed) until your application is approved.
GARMIN_CLIENT_ID=""
GARMIN_CLIENT_SECRET=""
GARMIN_REDIRECT_URI="http://localhost:3000/api/garmin/callback"

# Coach — Anthropic API key. Leave unset to fall back to canned replies.
ANTHROPIC_API_KEY=""
